{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evaluation.schema.json",
  "title": "Business Model Evaluator - evaluation.json (single source of truth)",
  "description": "The Markdown report is derived from this file, never the reverse (RF-OUT-01). Four verdicts only (RF-OUT-03).",
  "type": "object",
  "required": [
    "evaluation_date",
    "proposal_title",
    "verdict",
    "forced_verdict",
    "low_agreement",
    "runs",
    "lines",
    "gates",
    "modules",
    "ledger",
    "injection_findings",
    "forecasts",
    "reversal_conditions"
  ],
  "properties": {
    "evaluation_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "proposal_title": {
      "type": "string"
    },
    "neutral_restatement": {
      "type": "string"
    },
    "stage": {
      "enum": [
        "pre_launch",
        "operating"
      ]
    },
    "plain_answer": {
      "type": "string",
      "minLength": 10
    },
    "intake": {
      "type": "object",
      "description": "v0.7.2: resultado de check_intake.py (references/intake.md)",
      "properties": {
        "mode": {
          "enum": [
            "interactive",
            "non_interactive"
          ]
        },
        "mode_reason": {
          "type": "string",
          "enum": [
            "user_asked_no_questions",
            "no_human"
          ]
        },
        "unconfirmed_assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode"
      ]
    },
    "verdict": {
      "enum": [
        "GO",
        "CONDITIONAL_GO",
        "NO_GO",
        "INSUFFICIENT_EVIDENCE",
        null
      ]
    },
    "forced_verdict": {
      "enum": [
        "GO",
        "CONDITIONAL_GO",
        "NO_GO",
        null
      ]
    },
    "low_agreement": {
      "type": "boolean"
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "archetype"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "archetype": {
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4",
              "P-SAAS-SS",
              "P-SAAS-SL",
              "P-USAGE",
              "P-AI-APP",
              "P-INFRA",
              "P-MKT",
              null
            ]
          },
          "modifiers": {
            "type": "array",
            "items": {
              "enum": [
                "V",
                "AIX"
              ]
            }
          },
          "revenue_share": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "computed_by"
        ],
        "properties": {
          "id": {
            "enum": [
              "G0",
              "G1",
              "G2",
              "G2b",
              "G3",
              "G4",
              "G5",
              "G6",
              "G7"
            ]
          },
          "segment": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "conditional",
              "not_applicable",
              "declined"
            ]
          },
          "computed_by": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reversal_condition": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolved_by_bounds": {
            "type": "boolean"
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M([1-9]|1[0-6])$"
          },
          "score": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 5
          },
          "median": {
            "type": [
              "number",
              "null"
            ]
          },
          "iqr": {
            "type": [
              "number",
              "null"
            ]
          },
          "ceiling_applied": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "dimensions": {
      "type": "array"
    },
    "ledger": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "ledger.schema.json"
      }
    },
    "injection_findings": {
      "type": "array"
    },
    "forecasts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event",
          "resolution_date",
          "resolution_source"
        ]
      }
    },
    "reversal_conditions": {
      "type": "array"
    },
    "p0_list": {
      "type": "array"
    },
    "conditions": {
      "type": "array"
    },
    "tests": {
      "type": "array"
    },
    "market": {
      "type": "object"
    },
    "competitors": {
      "type": "object"
    },
    "ue_metrics": {
      "type": "object"
    },
    "projection": {
      "type": "object"
    },
    "stress_table": {
      "type": [
        "object",
        "null"
      ]
    },
    "web_calls": {
      "type": "integer",
      "minimum": 0
    },
    "flags": {
      "type": "array"
    },
    "strongest_case_against": {
      "type": "string"
    },
    "extracted_figures": {
      "type": "object"
    },
    "alerts": {
      "type": "array"
    },
    "hybrid": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "hybrid_segments": {
      "type": [
        "array",
        "null"
      ]
    },
    "thesis_line": {
      "type": [
        "array",
        "null"
      ]
    },
    "tornado": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "scenarios": {
      "type": [
        "object",
        "null"
      ]
    },
    "monte_carlo": {
      "type": [
        "object",
        "null"
      ]
    },
    "ai_native": {
      "type": [
        "object",
        "null"
      ]
    },
    "benchmarks": {
      "type": "array"
    },
    "next_steps": {
      "type": "array"
    },
    "language": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "reproducibility_manifest": {
      "type": "object",
      "required": [
        "ledger_sha256",
        "p0_requirements_sha256",
        "computed_metrics_sha256",
        "scripts_manifest",
        "schemas_manifest",
        "git_commit_or_plugin_version"
      ],
      "properties": {
        "ledger_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "p0_requirements_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "computed_metrics_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "scripts_manifest": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "schemas_manifest": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "git_commit_or_plugin_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
