{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "computed_metrics.schema.json",
  "title": "Deterministic Computed Metrics Output Contract (Draft 2020-12)",
  "type": "object",
  "required": [
    "schema_version",
    "evaluation_id",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": "0.4.9"},
    "evaluation_id": {"type": "string"},
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric_code",
          "value_decimal",
          "unit",
          "formula_ref",
          "input_ledger_ids"
        ],
        "properties": {
          "metric_code": {
            "type": "string",
            "pattern": "^(UE-[0-9]{2}|FM-[0-9]{2}|SA-[0-9]{2}|T[0-9]{1,2}|R[0-9]{1,2})$"
          },
          "value_decimal": {
            "type": "string",
            "pattern": "^-?[0-9]+(\\.[0-9]+)?$"
          },
          "unit": {
            "type": "string",
            "enum": ["USD", "EUR", "ratio", "percent", "months", "hours", "count", "score"]
          },
          "formula_ref": {
            "type": "string"
          },
          "input_ledger_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^L[0-9]+(_ADV_[0-9]+)?$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
